              "value": "[reference(resourceId('Microsoft.DBforMySQL/flexibleServers', parameters('serverName')), '2023-12-30').fullyQualifiedDomainName]"
            },
            "adminLogin": {
              "type": "string",
              "value": "[parameters('adminLogin')]"
            },
            "databaseName": {
              "type": "string",
              "value": "[parameters('databaseName')]"
